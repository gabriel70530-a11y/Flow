# Todas opcionais. Sem elas o app funciona e só esconde o que depende de cada uma.

# Link https de um formulário externo para a lista de interesse do Flow Pro.
NEXT_PUBLIC_PRO_INTEREST_URL=

# E-mail de contato exibido no rodapé do site.
NEXT_PUBLIC_CONTACT_EMAIL=

# Endpoint https que recebe eventos de uso anônimos (POST via sendBeacon). Só envia com consentimento em Ajustes.
NEXT_PUBLIC_ANALYTICS_URL=

# Endereço público do site, para sitemap, robots e cartões de compartilhamento (ex.: https://flowestudos.com.br).
# Na Vercel, sem ela, vale o endereço de produção do projeto.
NEXT_PUBLIC_SITE_URL=
