# Sem elas o app funciona e só esconde o que depende de cada uma (em produção, a conta exige o Supabase).

# Link https de um formulário externo para a lista de interesse do Flow Pro.
NEXT_PUBLIC_PRO_INTEREST_URL=

# E-mail de contato exibido no rodapé do site.
NEXT_PUBLIC_CONTACT_EMAIL=

# Endpoint https que recebe eventos de uso anônimos (POST via sendBeacon). Só envia com consentimento em Ajustes.
NEXT_PUBLIC_ANALYTICS_URL=

# Endereço público do site, para sitemap, robots e cartões de compartilhamento (ex.: https://flowestudos.com.br).
# Na Vercel, sem ela, vale o endereço de produção do projeto.
NEXT_PUBLIC_SITE_URL=

# Conta obrigatória com sincronização (Supabase). Sem as duas, a produção diz que a conta não está disponível
# e o desenvolvimento local abre o app sem conta.
# O esquema do banco está em supabase/migrations. A chave é a "publishable" (pública), nunca a secreta.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# true mostra "Entrar com Google". Só ligue depois de ativar o provedor Google no Supabase.
NEXT_PUBLIC_GOOGLE_LOGIN=

# true libera os recursos do Pro para todos (testes com estudantes). Nas funções do Supabase, use PRO_TRIAL=true junto.
NEXT_PUBLIC_PRO_TRIAL=

# true mostra os botões de assinar em Planos. Só ligue com o pagamento configurado nas funções (ver README).
NEXT_PUBLIC_PAYMENTS_OPEN=

# Chave pública VAPID dos lembretes por push (gerada com o par privado; o privado fica só na função send-reminders).
# Sem ela, os lembretes aparecem só com o Flow aberto.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Impressões SHA-256 dos certificados do app Android (Play Console > Integridade do app), separadas por vírgula.
# Vão para /.well-known/assetlinks.json; sem elas o app da Play Store abre com a barra de endereço do Chrome.
ANDROID_CERT_FINGERPRINTS=
